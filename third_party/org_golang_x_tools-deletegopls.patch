-  <select id="assign-select"><!--programmatic--></select>
-  <button id="assign-apply">Apply</button>
-</div>
-
-<div id="files"><!--programmatic--></div>
-
-<hr>
-
-<h2>Component dependencies</h2>
-
-<div id="deps"><!--programmatic--></div>
-`
