-func sortDiagnostics(d []*cache.Diagnostic) {
-	sort.Slice(d, func(i int, j int) bool {
-		a, b := d[i], d[j]
-		if r := protocol.CompareRange(a.Range, b.Range); r != 0 {
-			return r < 0
-		}
-		if a.Source != b.Source {
-			return a.Source < b.Source
-		}
