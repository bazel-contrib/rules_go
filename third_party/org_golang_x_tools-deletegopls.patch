-	// LSP 3.18 standard modifiers.
-	ModDefinition,
-	ModReadonly,
-	ModDefaultLibrary,
-	ModStatic,
-	// Additional custom modifiers.
-	ModArray,
-	ModBool,
-	ModChan,
-	ModFormat,
-	ModInterface,
