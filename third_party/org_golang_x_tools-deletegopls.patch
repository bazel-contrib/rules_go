-		check(test.x, test.y, test.want, true)
-		// unify is symmetric
-		check(test.y, test.x, test.want, true)
-		// unify is reflexive
-		check(test.x, test.x, true, false)
-		check(test.y, test.y, true, false)
-	}
-}
