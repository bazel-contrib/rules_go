-// FirstSession returns the first session by lexically sorted session ID, or
-// (nil, nil).
-func (s *StreamServer) FirstSession() (*cache.Session, protocol.Server) {
-	s.sessionMu.Lock()
-	defer s.sessionMu.Unlock()
-	keys := slices.Collect(maps.Keys(s.sessions))
