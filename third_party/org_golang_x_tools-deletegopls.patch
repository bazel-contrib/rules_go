-	// setindexInfo sets the (Posn, PkgPath, ObjectPath) fields for each method declaration.
-	setIndexInfo := func(m *gobMethod, method *types.Func) {
-		// error.Error has empty Position, PkgPath, and ObjectPath.
-		if method.Pkg() == nil {
-			return
-		}
