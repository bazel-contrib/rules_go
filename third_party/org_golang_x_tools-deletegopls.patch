-func wantStructFieldCompletions(enclosingCl *compLitInfo) bool {
-	if enclosingCl == nil {
-		return false
-	}
-	return is[*types.Struct](enclosingCl.clType) && (enclosingCl.inKey || enclosingCl.maybeInFieldName)
