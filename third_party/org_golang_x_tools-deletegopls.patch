-		src, ok := newContent[pgf.URI]
-		if !ok {
-			src = pgf.Src
-		}
-		fset := tokeninternal.FileSetFor(pgf.Tok)
-		src, err := rewriteSignature(fset, idx, src, newDecl)
-		if err != nil {
-			return nil, err
-		}
-		newContent[pgf.URI] = src
-	}
