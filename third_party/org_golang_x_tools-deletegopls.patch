-// deeper reports whether block x is lexically deeper than y.
-func deeper(x, y *types.Scope) bool {
-	if x == y || x == nil {
-		return false
-	} else if y == nil {
-		return true
-	} else {
-		return deeper(x.Parent(), y.Parent())
-	}
-}
