-func asEnum[S ~string](value any, options ...S) (S, error) {
-	str, err := asString(value)
-	if err != nil {
-		return "", err
-	}
-	for _, opt := range options {
-		if strings.EqualFold(str, string(opt)) {
-			return opt, nil
-		}
-	}
-	return "", fmt.Errorf("invalid option %q for enum", str)
-}
