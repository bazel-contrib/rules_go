-	checkOpen:
-		for _, files := range [][]file.Handle{inputs.goFiles, inputs.compiledGoFiles, inputs.asmFiles} {
-			for _, fh := range files {
-				if _, ok := fh.(*overlay); ok {
-					ph.isOpen = true
