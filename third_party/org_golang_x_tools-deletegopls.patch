-		t.Fatal(err)
-	}
-	// a function testing that std lib imports are found
-	ok := func(t *testing.T, env *Env) {
-		env.OpenFile("ok.go")
-		env.AfterChange(env.DoneWithOpen())
-		env.OrganizeImports("ok.go")
