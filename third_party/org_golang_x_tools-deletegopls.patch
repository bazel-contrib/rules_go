-func getUpgradeCodeAction(fh file.Handle, req *modfile.Require, version string) *protocol.Command {
-	return command.NewUpgradeDependencyCommand(upgradeTitle(version), command.DependencyArgs{
-		URI:        fh.URI(),
-		AddRequire: false,
