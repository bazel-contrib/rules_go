--- a/gopls/internal/golang/splitpkg/graph.go	2000-01-01 00:00:00.000000000 -0000
+++ b/gopls/internal/golang/splitpkg/graph.go	1970-01-01 00:00:00.000000000 +0000
@@ -1,101 +0,0 @@
