-	overlays := s.Overlays()
-	var openFiles []protocol.DocumentURI
-	for _, o := range overlays {
-		openFiles = append(openFiles, o.URI())
-	}
-
-	defs, err := selectViewDefs(ctx, s, newFolders, openFiles)
-	if err != nil {
-		return err
