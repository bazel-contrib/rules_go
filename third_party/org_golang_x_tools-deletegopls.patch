-func checkBuilder() string {
-	builder := os.Getenv("GO_BUILDER_NAME")
-	if reason, ok := longBuilders[builder]; ok && testing.Short() {
-		if reason != "" {
-			return fmt.Sprintf("skipping %s with -short due to %s", builder, reason)
