-// isEscaped reports whether the byte after buf is escaped
-func isEscaped(buf []byte) bool {
-	backSlashes := 0
-	for j := len(buf) - 1; j >= 0 && buf[j] == '\\'; j-- {
-		backSlashes++
-	}
-	return backSlashes%2 == 1
-}
