-// Smoke test that simultaneous editing sessions in the same workspace works.
-func TestSimultaneousEdits(t *testing.T) {
-	const sharedProgram = `
--- go.mod --
-module mod
-
-go 1.12
--- main.go --
-package main
-
-import "fmt"
-
-func main() {
-	fmt.Println("Hello World.")
-}`
