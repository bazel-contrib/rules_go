-// SuggestedFixFromCommand returns a suggested fix to run the given command.
-func SuggestedFixFromCommand(cmd *protocol.Command, kind protocol.CodeActionKind) SuggestedFix {
-	return SuggestedFix{
-		Title:      cmd.Title,
-		Command:    cmd,
-		ActionKind: kind,
-	}
-}
