-// go1Point returns the x in Go 1.x. If an error occurs extracting the go
-// version, it returns -1.
-//
-// Copied from the testenv package.
-func go1Point() int {
-	for _, tag := range slices.Backward(build.Default.ReleaseTags) {
-		var version int
-		if _, err := fmt.Sscanf(tag, "go1.%d", &version); err != nil {
-			continue
-		}
-		return version
-	}
-	return -1
-}
