-
--- a/a.go --
-package a
-
-// The 'π' suffix is to elimimate spurious matches with other HTML substrings,
-// in particular the random base64 secret tokens that appear in gopls URLs.
-
-var Vπ, vπ = 0, 0
-const Cπ, cπ = 0, 0
-
-func Fπ()
-func fπ()
-
-type Tπ int
-type tπ int
-
-func (Tπ) Mπ() {}
-func (Tπ) mπ() {}
-
-func (tπ) Mπ() {}
-func (tπ) mπ() {}
-`
