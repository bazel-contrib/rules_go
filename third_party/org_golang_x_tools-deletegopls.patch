-func exactlyOneNamedArg(mark marker, names ...string) bool {
-	var found []string
-	for _, name := range names {
-		if _, ok := mark.note.NamedArgs[name]; ok {
-			found = append(found, name)
-		}
-	}
-	if len(found) != 1 {
-		mark.errorf("need exactly one of %v to be set, got %v", names, found)
-		return false
-	}
-	return true
-}
