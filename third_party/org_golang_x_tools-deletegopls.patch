-type TestEnv struct {
-	Conns   []*jsonrpc2_v2.Connection
-	Servers []*jsonrpc2_v2.Server
-}
-
-func (e *TestEnv) Shutdown(t *testing.T) {
-	for _, s := range e.Servers {
-		s.Shutdown()
-	}
-	for _, c := range e.Conns {
-		if err := c.Close(); err != nil {
-			t.Error(err)
-		}
-	}
-	for _, s := range e.Servers {
-		if err := s.Wait(); err != nil {
-			t.Error(err)
-		}
-	}
-}
