-	line := safetoken.Line(file, n.Pos())
-	start, err := safetoken.Offset(file, file.LineStart(line))
-	if err != nil {
-		return ""
-	}
-	end := start
-	for ; end < len(tv.pgf.Src) && tv.pgf.Src[end] != '\n'; end++ {
-
-	}
-	return string(tv.pgf.Src[start:end])
-}
