-	var resultHasTypeParams bool
-	for v := range results.Variables() {
-		if tp, ok := types.Unalias(v.Type()).(*types.TypeParam); ok && !c.typeParamInScope(tp) {
-			resultHasTypeParams = true
-		}
-	}
