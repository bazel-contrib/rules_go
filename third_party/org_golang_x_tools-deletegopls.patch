--- a/gopls/internal/analysis/deprecated/deprecated_test.go	2000-01-01 00:00:00.000000000 -0000
+++ b/gopls/internal/analysis/deprecated/deprecated_test.go	1970-01-01 00:00:00.000000000 +0000
@@ -1,16 +0,0 @@
-// Copyright 2023 The Go Authors. All rights reserved.
