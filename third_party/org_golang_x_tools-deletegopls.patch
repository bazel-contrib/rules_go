-var _ memoize.RefCounted = (*Snapshot)(nil) // snapshots are reference-counted
-
-func (s *Snapshot) awaitPromise(ctx context.Context, p *memoize.Promise) (any, error) {
-	return p.Get(ctx, s)
-}
