-func units(v float64, suffixes []string) string {
-	s := ""
-	for _, s = range suffixes {
-		n := v / 1000
-		if n < 1 {
-			break
-		}
-		v = n
-	}
-	return fmt.Sprintf("%.2f%s", v, s)
-}
-
-type byteUnits float64
-
-func (v byteUnits) String() string {
-	return units(float64(v), []string{"B", "KB", "MB", "GB", "TB"})
-}
