-  // Link (from -> to) to the reference in from.
-  const refLink = document.createElement('a');
-  refItem.appendChild(refLink);
-  refLink.addEventListener('click', () => httpGET(refData.URL));
-  refLink.textContent = "${refData.From} ➤ ${refData.To}";
-
-  return refItem;
-}
