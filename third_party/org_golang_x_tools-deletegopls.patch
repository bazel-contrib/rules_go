-	return func(pkgPath PackagePath) (id, altID PackageID) {
-		if id, ok := impMap[pkgPath]; ok {
-			return id, altIDs[pkgPath]
-		}
-		for len(pending) > 0 {
-			if id, found := search(pkgPath); found {
