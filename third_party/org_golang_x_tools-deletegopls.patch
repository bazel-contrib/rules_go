-		for _, f := range pkg.CompiledGoFiles {
-			g.Go(func() error {
-				content, err := os.ReadFile(f)
-				// We report errors via t.Error, not by returning,
-				// so that a single test can report multiple test failures.
-				if err != nil {
-					t.Errorf("failed to read %s: %v", f, err)
-					return nil
