-	if err != nil {
-		return err
-	}
-	if len(evts) == 0 {
-		return nil
-	}
-	w.watcherMu.Lock()
-	watchers := slices.Clone(w.watchers)
-	w.watcherMu.Unlock()
-	for _, w := range watchers {
-		w(ctx, evts)
