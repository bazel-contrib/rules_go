-		switch x := x.(type) {
-		case *types.Array:
-			y := y.(*types.Array)
-			return x.Len() == y.Len() &&
-				uni(x.Elem(), y.Elem())
-
-		case *types.Basic:
-			y := y.(*types.Basic)
