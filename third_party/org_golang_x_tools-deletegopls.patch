-			(is[*ast.Ident](expr.X) ||
-				is[*ast.SelectorExpr](expr.X) ||
-				is[*ast.IndexExpr](expr.X) ||
-				is[*ast.StarExpr](expr.X)) {
-			return fakeIdent
-		}
-	}
