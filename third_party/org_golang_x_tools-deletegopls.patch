-// getZeroVals returns the "zero values" from the given list of returnVariable.
-func getZeroVals(retVars []*returnVariable) []ast.Expr {
-	var zvs []ast.Expr
-	for _, retVar := range retVars {
-		zvs = append(zvs, retVar.zeroVal)
