-	// Call ipcChild in a child process,
-	// passing it the keys in the environment
-	// (quoted, to avoid NUL termination of C strings).
-	// It will Get(A) then Set(B).
-	cmd := exec.Command(os.Args[0], os.Args[1:]...)
