-func generatePatterns() []string {
-	var patterns []string
-	for x := 'a'; x <= 'z'; x++ {
-		for y := 'a'; y <= 'z'; y++ {
-			for z := 'a'; z <= 'z'; z++ {
-				patterns = append(patterns, string(x)+string(y)+string(z))
-			}
-		}
-	}
-	return patterns
-}
