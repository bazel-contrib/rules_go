-	// TokDecorator  Type = "decorator"
-	// TokEnum       Type = "enum"
-	// TokEnumMember Type = "enumMember"
-	// TokEvent      Type = "event"
-	// TokInterface  Type = "interface"
-	// TokModifier   Type = "modifier"
-	// TokRegexp     Type = "regexp"
-	// TokStruct     Type = "struct"
-)
