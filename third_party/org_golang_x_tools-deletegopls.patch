-// NewEditor creates a new Editor.
-func NewEditor(sandbox *Sandbox, config EditorConfig) *Editor {
-	return &Editor{
-		buffers: make(map[string]buffer),
-		sandbox: sandbox,
-		config:  config,
-	}
-}
