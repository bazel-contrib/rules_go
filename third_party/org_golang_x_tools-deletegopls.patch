-				sym := words[1]
-				sym = cutBefore(sym, ",") // strip ",NOSPLIT,$12" etc
-				sym = cutBefore(sym, "(") // "sym(SB)" -> "sym"
-				sym = cutBefore(sym, "<") // "sym<ABIInternal>" -> "sym"
-				sym = strings.TrimSpace(sym)
