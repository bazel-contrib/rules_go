-	// If an error is already shown to the user, update it or mark it as
-	// resolved.
-	if errMsg == "" {
-		s.criticalErrorStatus.End(ctx, "Done.")
-		s.criticalErrorStatus = nil
-	} else {
-		s.criticalErrorStatus.Report(ctx, errMsg, 0)
