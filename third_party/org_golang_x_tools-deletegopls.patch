-	// maxima
-	max1 := Ints{
-		U:    math.MaxUint,
-		U8:   math.MaxUint8,
-		U16:  math.MaxUint16,
-		U32:  math.MaxUint32,
-		U64:  math.MaxUint64,
-		UP:   math.MaxUint,
-		I:    math.MaxInt,
-		I8:   math.MaxInt8,
