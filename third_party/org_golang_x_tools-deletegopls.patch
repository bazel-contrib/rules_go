-				}
-			}
-			return obj.Type()
-		}
-
-		check := func(a, b string, want, compareParams bool) {
-			t.Helper()
-
-			ta := lookup(a)
-			tb := lookup(b)
-
-			var gotParams tmap
-			if test.params == nil {
-				// Get the unifier even if there are no input params.
