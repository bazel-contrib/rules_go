-var Supported = []Support{
-	{12, "", "v0.7.5"},
-	{15, "", "v0.9.5"},
-	{16, "", "v0.11.0"},
-	{17, "", "v0.11.0"},
-	{18, "", "v0.14.2"},
-	{19, "v0.17.0", "v0.15.3"},
-	{20, "v0.17.0", "v0.15.3"},
