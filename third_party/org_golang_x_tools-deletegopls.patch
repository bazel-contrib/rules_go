-func toOSVPackages(pkgs []*Package) (imps []osv.Package) {
-	for _, p := range pkgs {
-		syms := slices.Clone(p.Symbols)
-		syms = append(syms, p.DerivedSymbols...)
-		sort.Strings(syms)
-		imps = append(imps, osv.Package{
