-	clientStream := jsonrpc2.NewHeaderStream(fakenet.NewConn("stdio", stdout, stdin))
-	clientConn := jsonrpc2.NewConn(clientStream)
-
-	go func() {
-		select {
-		case <-ctx.Done():
-			clientConn.Close()   // ignore error
-			clientStream.Close() // ignore error
-		case <-clientConn.Done():
-		}
-	}()
-
-	return clientConn
-}
