-	s1, s2 := "hello", "world"
-	x := Basics{
-		A: []*string{&s1, nil, &s2},
-		B: [...]int{1, 2},
-		C: &Basics{
-			B: [...]int{3, 4},
-			D: map[string]int{"one": 1},
-		},
-		E: []byte("hello"),
-		F: []string{s1, s2},
