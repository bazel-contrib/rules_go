-type Rpcs struct { // exported for testing
-	mu       sync.Mutex
-	Inbound  []*rpcStats // stats for incoming lsp rpcs sorted by method name
-	Outbound []*rpcStats // stats for outgoing lsp rpcs sorted by method name
-}
