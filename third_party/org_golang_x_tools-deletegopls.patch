-type FixType int
-
-const (
-	noFix FixType = iota
-	FixedCurlies
-	FixedDanglingSelector
-	FixedDeferOrGo
-	FixedArrayType
-	FixedInit
-	FixedPhantomSelector
-	FixedEmptySwitch
-)
