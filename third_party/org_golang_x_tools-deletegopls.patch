-// ElemType returns the Elem() type of xType, if applicable.
-func (a *postfixTmplArgs) ElemType() types.Type {
-	type hasElem interface{ Elem() types.Type } // Array, Chan, Map, Pointer, Slice
-	if e, ok := a.Type.Underlying().(hasElem); ok {
-		return e.Elem()
