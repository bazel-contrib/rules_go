-	var srcErrs []*Diagnostic
-	for pm, le := range diagLocations {
-		diag, err := s.goCommandDiagnostic(pm, le.loc, le.msg)
-		if err != nil {
-			event.Error(ctx, "building go command diagnostic", err)
-			continue
-		}
-		srcErrs = append(srcErrs, diag)
-	}
-	return srcErrs
-}
