-	// Write overlay files for unsaved editor buffers.
-	overlay, cleanup, err := gocommand.WriteOverlays(s.buildOverlays())
-	if err != nil {
-		return nil, nil, err
-	}
-	inv.Overlay = overlay
-	return inv, cleanup, nil
