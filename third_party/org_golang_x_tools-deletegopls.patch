-	// to Path(), but at least consolidates URI manipulation.
-	return URIFromPath(uri.DirPath())
-}
-
-// DirPath returns the file path to the directory containing this URI, which
-// must be a file URI.
-func (uri DocumentURI) DirPath() string {
