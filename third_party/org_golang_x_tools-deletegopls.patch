-			if err != nil {
-				return err
-			}
-			content, err := fh.Content()
-			if err != nil {
-				return err
-			}
-			oldFile, newFile = filepath.ToSlash(change.DeleteFile.URI.Path()), "/dev/null"
-			oldContent, newContent = string(content), ""
-		case change.RenameFile != nil:
