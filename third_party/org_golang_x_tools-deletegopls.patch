-
-	s.diagnosticsMu.Lock()
-	defer s.diagnosticsMu.Unlock()
-
-	for uri, diags := range diagnostics {
-		f, ok := s.diagnostics[uri]
-		if !ok {
-			f = new(fileDiagnostics)
-			s.diagnostics[uri] = f
-		}
