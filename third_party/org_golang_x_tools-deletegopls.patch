-func isTypeParam(t types.Type) bool {
-	_, ok := types.Unalias(t).(*types.TypeParam)
-	return ok
-}
-
-func asNamed(t types.Type) *types.Named {
-	n, _ := types.Unalias(t).(*types.Named)
