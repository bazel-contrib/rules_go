-		Mode:     mode,
-		Src:      src,
-		fixedSrc: fixedSrc,
-		fixedAST: fixedAST,
-		File:     file,
-		Tok:      tok,
-		Mapper:   protocol.NewMapper(uri, src),
-		ParseErr: parseErr,
