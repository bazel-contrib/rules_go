-// isScheme reports whether s is a recognized URL scheme.
-// Note that if strings of new length (beyond 3-7)
-// are added here, the fast path at the top of autoURL will need updating.
-func isScheme(s string) bool {
-	switch s {
-	case "file",
-		"ftp",
-		"gopher",
-		"http",
-		"https",
-		"mailto",
-		"nntp":
-		return true
-	}
-	return false
-}
