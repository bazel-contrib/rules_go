-		fix := fixedVersion(findings[0].FixedVersion)
-		pkgs := vulnerablePkgsInfo(findings, useMarkdown)
-		osvEntry := osvs[k]
-
-		if useMarkdown {
-			fmt.Fprintf(&b, "- [%v](%v) %v%v\n%v\n", k, href(k), osvEntry.Summary, pkgs, fix)
