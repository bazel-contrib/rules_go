-			def, err = formatDefaultFromEnumBoolMap(reflectField, v.Value)
-			if err != nil {
-				return nil, err
-			}
-		}
-		keys = append(keys, doc.EnumKey{
-			Name:    v.Value,
-			Doc:     v.Doc,
-			Status:  v.Status,
-			Default: def,
-		})
