-		for _, name := range class.Decls {
-			p.transitiveRefs[name] = set
-		}
-	}
-
-	// Finally compute the union of transitiveRefs
-	// across the direct deps of this package.
-	byDeps, err := g.reachesByDeps(ctx, p.metapkg)
-	if err != nil {
-		return nil, err
-	}
-	p.ReachesByDeps = byDeps
-
-	return p, nil
-}
