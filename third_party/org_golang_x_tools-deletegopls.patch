-	if curExprs, err := canExtractVariable(info, req.pgf.Cursor(), req.start, req.end, false); err == nil && len(curExprs) > 0 {
-		// Offer one of refactor.extract.{constant,variable}
-		// based on the constness of the expression; this is a
