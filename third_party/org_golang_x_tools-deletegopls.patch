-	// The search functions will call report(loc) for each hit.
-	var (
-		refsMu sync.Mutex
-		refs   []reference
-	)
-	report := func(loc protocol.Location, isDecl bool) {
-		ref := reference{
-			isDeclaration: isDecl,
-			location:      loc,
-			pkgPath:       pkg.Metadata().PkgPath,
-		}
-		refsMu.Lock()
-		refs = append(refs, ref)
-		refsMu.Unlock()
-	}
