-	// State transition: validLocalInputs -> validKey
-
-	// Check if any dependencies have actually changed.
-	depsChanged := true
-	if ph.depKeys != nil { // ph was previously evaluated
-		depsChanged = len(ph.depKeys) != len(n.succs)
