-func objectKind(obj types.Object) string {
-	if obj == nil {
-		return "nil object"
-	}
-	switch obj := obj.(type) {
-	case *types.PkgName:
-		return "imported package name"
-	case *types.TypeName:
-		return "type"
-	case *types.Var:
-		if obj.IsField() {
