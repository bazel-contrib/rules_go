-
-	var upgrades []string
-	for module, version := range modulesToUpgrade {
-		upgrades = append(upgrades, module+"@"+version)
-	}
-
-	if err := runGoCommand(ctx, snapshot, uri, "get", upgrades); err != nil {
-		msg := fmt.Sprintf("Failed to upgrade modules: %v", err)
