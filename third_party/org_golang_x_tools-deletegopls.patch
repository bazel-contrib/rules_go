-	if cfg.forURI != "" {
-		deps.fh, deps.snapshot, release, err = c.s.session.FileOf(ctx, cfg.forURI)
-		if err != nil {
-			return err
-		}
-
-	} else if cfg.forView != "" {
-		view, err := c.s.session.View(cfg.forView)
-		if err != nil {
-			return err
-		}
-		deps.snapshot, release, err = view.Snapshot()
-		if err != nil {
-			return err
-		}
-
-	} else {
-		release = func() {}
