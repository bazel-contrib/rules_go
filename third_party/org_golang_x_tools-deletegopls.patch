-func (s *server) saveLastCompletion(uri protocol.DocumentURI, version int32, items []protocol.CompletionItem, pos protocol.Position) {
-	s.efficacyMu.Lock()
-	defer s.efficacyMu.Unlock()
-	s.efficacyVersion = version
-	s.efficacyURI = uri
-	s.efficacyPos = pos
-	s.efficacyItems = items
-}
