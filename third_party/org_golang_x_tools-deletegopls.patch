-// XORWith updates *h to *h XOR h2.
-func (h *Hash) XORWith(h2 Hash) {
-	// Small enough that we don't need crypto/subtle.XORBytes.
-	for i := range h {
-		h[i] ^= h2[i]
-	}
-}
