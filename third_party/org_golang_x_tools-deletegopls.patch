-	Name:             "fillreturns",
-	Doc:              analyzerutil.MustExtractDoc(doc, "fillreturns"),
-	Requires:         []*analysis.Analyzer{inspect.Analyzer},
-	Run:              run,
-	RunDespiteErrors: true,
-	URL:              "https://pkg.go.dev/golang.org/x/tools/gopls/internal/analysis/fillreturns",
