-
-	funcRng, err := pgf.PosRange(ftyp.Func, ftyp.Func)
-	if err != nil {
-		return nil, err
-	}
-	changes, err := ChangeSignature(ctx, snapshot, pkg, pgf, funcRng, newParams)
-	if err != nil {
